{
  "manifest_version": 3,
  "name": "exile-price live notice",
  "version": "0.1.0",
  "description": "Tells exile-price when a trade live search tab plays its sound. Reads the tab only; sends nothing to the trade site.",
  "key": "",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://www.pathofexile.com/trade/search/*"],
      "js": ["label.js"],
      "run_at": "document_idle"
    }
  ]
}
